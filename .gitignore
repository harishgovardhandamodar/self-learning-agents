# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Local runtime state — the SQLite database and exported projects are
# generated by the app, not source. The reference data (measured bands,
# live validation) lives in reference/ and IS tracked.
data/*.db
data/*.db-shm
data/*.db-wal
exports/*
!exports/.gitkeep

# Node tooling (the UI audit) — dev-only.
node_modules/
npm-debug.log*

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Local env / editor
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
.DS_Store
